{
  "_schema_doc": {
    "description": "Campaign Configuration - defines a single campaign including products and UGC gallery. Generated and managed by the Admin API.",
    "field_constraints": {
      "campaign_id": {
        "type": "string",
        "format": "UUID v4",
        "description": "Unique campaign identifier"
      },
      "campaign_name": {
        "type": "string",
        "description": "Human-readable campaign name",
        "constraints": "Max 200 characters"
      },
      "product_mode": {
        "type": "string",
        "enum": ["single", "multiple"],
        "description": "Determines whether campaign offers one or many products"
      },
      "market": {
        "type": "string",
        "enum": ["ko", "ja", "en"],
        "description": "Target market language code"
      },
      "hero_image_url": {
        "type": "string (uri)",
        "description": "Campaign hero/banner image URL",
        "constraints": "Valid http/https URL, max 2048 characters"
      },
      "introduction_text": {
        "type": "string",
        "description": "Campaign introduction/description text",
        "constraints": "Max 2000 characters"
      },
      "status": {
        "type": "string",
        "enum": ["draft", "published"],
        "description": "Campaign publication status"
      },
      "created_at": {
        "type": "string",
        "format": "ISO 8601 UTC (e.g. 2025-01-15T09:00:00Z)",
        "description": "Campaign creation timestamp"
      },
      "updated_at": {
        "type": "string",
        "format": "ISO 8601 UTC (e.g. 2025-01-15T09:00:00Z)",
        "description": "Last update timestamp"
      },
      "products": {
        "type": "array of CampaignProduct",
        "description": "Products assigned to this campaign (1 for single mode, 1-50 for multiple mode)"
      },
      "ugc_gallery": {
        "type": "array of UGCPost",
        "description": "Curated UGC posts displayed on campaign page (max 20)"
      },
      "campaign_product_fields": {
        "product_id": "string - references Product_Library product_id",
        "product_name": "string - max 200 characters",
        "product_image_url": "string (uri) - valid http/https URL, max 2048 characters",
        "short_description": "string - max 500 characters",
        "product_detail_url": "string | null - valid http/https URL, max 2048 characters",
        "size_guide_url": "string | null - valid http/https URL, max 2048 characters",
        "available_sizes": "array of strings - 1-20 items",
        "available_colors": "array of strings - 1-30 items",
        "status": "string enum: open | closed",
        "display_order": "integer - 1-50",
        "override_product_image_url": "string | null - overrides library default",
        "override_product_detail_url": "string | null - overrides library default",
        "override_size_guide_url": "string | null - overrides library default",
        "override_short_description": "string | null - overrides library default"
      },
      "ugc_post_fields": {
        "post_id": "string - UUID v4",
        "image_url": "string (uri) - valid http/https URL, max 2048 characters",
        "source_url": "string | null - Instagram post URL",
        "display_order": "integer - 1-20"
      }
    }
  },
